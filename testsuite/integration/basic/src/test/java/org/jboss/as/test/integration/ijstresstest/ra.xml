<connector xmlns="http://java.sun.com/xml/ns/javaee"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
           http://java.sun.com/xml/ns/j2ee/connector_1_6.xsd"
           version="1.6" metadata-complete="true">
    <vendor-name>Red Hat Middleware LLC</vendor-name>
    <eis-type>Test RA</eis-type>
    <resourceadapter-version>0.1</resourceadapter-version>
    <resourceadapter id="pies">
        <resourceadapter-class>org.jboss.as.test.integration.ijstresstest.StressTestResourceAdapter</resourceadapter-class>
        <outbound-resourceadapter>
            <connection-definition>
                <managedconnectionfactory-class>org.jboss.as.test.integration.ijstresstest.StressTestManagedConnectionFactory</managedconnectionfactory-class>
                <connectionfactory-interface>org.jboss.as.test.integration.ijstresstest.StressTestConnectionFactory</connectionfactory-interface>
                <connectionfactory-impl-class>org.jboss.as.test.integration.ijstresstest.StressTestConnectionFactoryImpl</connectionfactory-impl-class>
                <connection-interface>org.jboss.as.test.integration.ijstresstest.StressTestConnection</connection-interface>
                <connection-impl-class>org.jboss.as.test.integration.ijstresstest.StressTestConnectionImpl</connection-impl-class>
            </connection-definition>
            <transaction-support>NoTransaction</transaction-support>
            <reauthentication-support>false</reauthentication-support>
        </outbound-resourceadapter>
    </resourceadapter>
</connector>
